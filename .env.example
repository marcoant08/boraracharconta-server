# MongoDB
MONGODB_URI=mongodb://localhost:27017/finances

# JWT
JWT_SECRET=my-secret-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=my-email@gmail.com
SMTP_PASS=my-app-password
SMTP_FROM=noreply@finances.com

# Server
PORT=3000

# URL pública do frontend. No ar, use o domínio hospedado (pode listar vários, separados por vírgula).
# Em localhost o retorno também aceita a origem da página que iniciou o login.
FRONTEND_URL=http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
